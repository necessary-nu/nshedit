name libedit

source {
    url "git@github.com:necessary-nu/libedit.git"
    ref main
}

children (
    {
        id encoding
        title "Character encoding and escaping: chartype, literal, vis, unvis"
        children (
            {
                id encoding-markup
                title "Author sem rules for the encoding primitives"
                sealed true
                log (
                    {
                        at 2026-08-04T17:36:33.842493851Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Done (nplan complete)"
                    }
                )
            }

            {
                id encoding-translate
                title "Translate the encoding primitives to Rust"
                deps (encoding-markup)
                sealed true
            }

            {
                id encoding-tests
                title "Port and extend tests for the encoding primitives"
                deps (encoding-translate)
                sealed true
            }

            {
                id encoding-idiomatize
                title "Idiomatize the encoding primitives"
                deps (encoding-tests)
                sealed true
            }
        )
        sealed true
    }

    {
        id terminal
        title "Terminal capability and tty control: terminal, tty"
        children (
            {
                id terminal-markup
                title "Author sem rules for the terminal layer"
                sealed true
                log (
                    {
                        at 2026-08-04T17:36:36.115234384Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Done (nplan complete)"
                    }
                )
            }

            {
                id terminal-translate
                title "Translate the terminal layer to Rust over terminfo"
                deps (terminal-markup)
                sealed true
            }

            {
                id terminal-tests
                title "Port and extend tests for the terminal layer"
                deps (terminal-translate platform-build)
                sealed true
            }

            {
                id terminal-idiomatize
                title "Idiomatize the terminal layer"
                deps (terminal-tests)
                sealed true
            }
        )
        sealed true
    }

    {
        id buffer
        title "Line buffer and screen refresh: chared, refresh, prompt"
        children (
            {
                id buffer-markup
                title "Author sem rules for the line buffer and refresh"
                sealed true
                log (
                    {
                        at 2026-08-04T17:36:38.409244357Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Done (nplan complete)"
                    }
                )
            }

            {
                id buffer-translate
                title "Translate the line buffer and refresh to Rust"
                deps (buffer-markup)
                sealed true
            }

            {
                id buffer-tests
                title "Port and extend tests for the line buffer and refresh"
                deps (buffer-translate platform-build)
                sealed true
            }

            {
                id buffer-idiomatize
                title "Idiomatize the line buffer and refresh"
                deps (buffer-tests)
                sealed true
            }
        )
        sealed true
    }

    {
        id input
        title "Input dispatch and key binding: read, keymacro, map, parse, sig"
        children (
            {
                id input-markup
                title "Author sem rules for input dispatch and binding"
                sealed true
                log (
                    {
                        at 2026-08-04T17:36:40.85408045Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Done (nplan complete)"
                    }
                )
            }

            {
                id input-translate
                title "Translate input dispatch and binding to Rust"
                deps (input-markup)
                sealed true
            }

            {
                id input-tests
                title "Port and extend tests for input dispatch and binding"
                deps (input-translate platform-build)
                sealed true
            }

            {
                id input-idiomatize
                title "Idiomatize input dispatch and binding"
                deps (input-tests)
                sealed true
            }
        )
        sealed true
    }

    {
        id history
        title "History storage and search: history, hist, search"
        children (
            {
                id history-markup
                title "Author sem rules for history and search"
                sealed true
                log (
                    {
                        at 2026-08-04T17:36:53.793829965Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Done (nplan complete)"
                    }
                )
            }

            {
                id history-translate
                title "Translate history and search to Rust"
                deps (history-markup)
                sealed true
            }

            {
                id history-tests
                title "Port and extend tests for history and search"
                deps (history-translate history-regex)
                sealed true
            }

            {
                id history-idiomatize
                title "Idiomatize history and search"
                deps (history-tests)
                sealed true
            }

            {
                id history-regex
                title "Choose and integrate a basic-regex engine for history search"
                deps (history-translate)
            }
        )
    }

    {
        id modes
        title "Editor command sets: vi, emacs, common"
        children (
            {
                id modes-markup
                title "Author sem rules for the editor command sets"
                sealed true
                log (
                    {
                        at 2026-08-04T17:36:56.328736304Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Done (nplan complete)"
                    }
                )
            }

            {
                id modes-translate
                title "Translate the editor command sets to Rust"
                deps (modes-markup)
                sealed true
            }

            {
                id modes-tests
                title "Port and extend tests for the editor command sets"
                deps (modes-translate platform-build)
                sealed true
            }

            {
                id modes-idiomatize
                title "Idiomatize the editor command sets"
                deps (modes-tests)
                sealed true
            }
        )
        sealed true
    }

    {
        id completion
        title "Completion and tokenization: filecomplete, tokenizer"
        children (
            {
                id completion-markup
                title "Author sem rules for completion and tokenization"
                sealed true
                log (
                    {
                        at 2026-08-04T17:36:58.919622846Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Done (nplan complete)"
                    }
                )
            }

            {
                id completion-translate
                title "Translate completion and tokenization to Rust"
                deps (completion-markup)
                sealed true
            }

            {
                id completion-tests
                title "Port and extend tests for completion and tokenization"
                deps (completion-translate platform-build)
                sealed true
            }

            {
                id completion-idiomatize
                title "Idiomatize completion and tokenization"
                deps (completion-tests)
                sealed true
            }
        )
        sealed true
    }

    {
        id core-api
        title "EditLine lifecycle and the histedit public API: el, eln, histedit"
        children (
            {
                id core-api-markup
                title "Author sem rules for the EditLine lifecycle and public API"
                sealed true
                log (
                    {
                        at 2026-08-04T17:37:01.58878447Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Done (nplan complete)"
                    }
                )
            }

            {
                id core-api-translate
                title "Translate the EditLine lifecycle and public API to Rust"
                deps (core-api-markup)
                sealed true
            }

            {
                id core-api-tests
                title "Port and extend tests for the EditLine lifecycle and public API"
                deps (
                    core-api-translate
                    abi-callback-types
                    abi-visibility
                    abi-varargs
                    abi-narrow
                    platform-build
                )
                sealed true
            }

            {
                id core-api-idiomatize
                title "Idiomatize the EditLine lifecycle and public API"
                deps (core-api-tests)
                sealed true
            }
        )
        sealed true
    }

    {
        id readline-compat
        title "GNU readline compatibility surface: readline, editline/readline"
        children (
            {
                id readline-compat-markup
                title "Author sem rules for the readline compatibility surface"
                sealed true
                log (
                    {
                        at 2026-08-04T17:37:04.692153774Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Done (nplan complete)"
                    }
                )
            }

            {
                id readline-compat-translate
                title "Translate the readline compatibility surface to Rust"
                deps (readline-compat-markup)
                sealed true
            }

            {
                id readline-compat-tests
                title "Port and extend tests for the readline compatibility surface"
                deps (
                    readline-compat-translate
                    abi-callback-types
                    abi-visibility
                    abi-varargs
                    abi-narrow
                    abi-errno
                    platform-build
                )
                sealed true
            }

            {
                id readline-compat-idiomatize
                title "Idiomatize the readline compatibility surface"
                deps (readline-compat-tests)
                sealed true
            }
        )
        sealed true
    }

    {
        id platform
        title "System access the port needs because libc is barred: syscalls, terminal control, the user database"
        children (
            {
                id platform-decide
                title "Decide the platform layer's scope, and record the divergences it forces"
            }

            {
                id platform-build
                title "Build one platform module and retire the six private stubs"
                deps (platform-decide)
            }

            {
                id platform-tests
                title "Test the platform layer against the C's observable behaviour"
                deps (platform-build)
            }
        )
    }

    {
        id abi-surface
        title "Make the exported C ABI reachable from the core"
        children (
            {
                id abi-callback-types
                title "Give the nine core callback typedefs the C ABI a caller actually passes"
            }

            {
                id abi-visibility
                title "Publish the thirty core entry points the ABI crate has to call"
            }

            {
                id abi-varargs
                title "Provide a typed dispatch the variadic shims and the readline layer can both call"
                deps (abi-visibility abi-callback-types)
            }

            {
                id abi-narrow
                title "Decide and build the narrow history and tokenizer instantiations, which have byte semantics the wide store does not"
                deps (abi-visibility)
            }

            {
                id abi-errno
                title "Give errno a writable home the ABI crate can publish to C callers"
            }
        )
    }

    {
        id spec-repair
        title "Correct the spec and the register against what translation measured"
        children (
            {
                id spec-rule-corrections
                title "Fix the six rules translation proved wrong about the C"
            }

            {
                id errata-reconcile
                title "Reconcile the register with what translation resolved, defined, under-scoped and newly found"
            }

            {
                id readline-globals-rules
                title "Write rules for the sixty exported readline globals, which have none"
            }
        )
    }
)
