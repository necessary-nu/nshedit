name libedit

source {
    url "git@github.com:necessary-nu/libedit.git"
    ref main
}

children (
    {
        id encoding
        title "Character encoding and escaping: chartype, literal, vis, unvis"
        children (
            {
                id encoding-markup
                title "Author sem rules for the encoding primitives"
                sealed true
                log (
                    {
                        at 2026-08-04T17:36:33.842493851Z
                        author "brendan@necessary.nu"
                        kind @status
                        text "Todo → Done (nplan complete)"
                    }
                )
            }

            {
                id encoding-translate
                title "Translate the encoding primitives to Rust"
                deps (encoding-markup)
                sealed true
            }

            {
                id encoding-tests
                title "Port and extend tests for the encoding primitives"
                deps (encoding-translate)
                sealed true
            }

            {
                id encoding-idiomatize
                title "Idiomatize the encoding primitives"
                deps (encoding-tests)
                sealed true
            }
        )
        sealed true
    }

