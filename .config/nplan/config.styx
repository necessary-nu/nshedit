platforms (
    {
        platform "rust"
        files (Cargo.toml Cargo.lock .config/**/*.styx crates/**/Cargo.toml crates/**/*.rs conformance/**/*.sh packaging/**/*.sh)
        checks {
            // The workspace has no path dependency outside this repository,
            // so Cargo's workspace-wide formatter is both complete and safe.
            format {
                cmd "cargo fmt --all -- --check"
                fix "cargo fmt --all"
            }
            lint {
                cmd "cargo clippy --workspace --all-targets -- -D warnings"
                fix "cargo clippy --workspace --all-targets --fix --allow-dirty --allow-staged"
            }
            test {
                cmd "bash -c \"cargo build --workspace && cargo test --workspace\""
            }
        }
    }
)

comment-smells {
    // "Phase N" is this project's spec vocabulary, not a plan reference. The
    // sem rules name the stages of an algorithm that way — refresh's
    // line-differencing engine has four, and its rule heads them "Phase 1 —
    // find the boundaries" and so on — so a code comment saying the same
    // thing points the reader at the paragraph that specifies it. That is the
    // opposite of a comment meaning nothing to the next reader.
    //
    // Deliberately bounded to the range the rules actually use, so a genuine
    // transient reference to an adoption or wave phase still fires.
    allow ("(?i)\\bphase [1-4]\\b")
}

annotations {
    mode @both
}

quality {
    // Structural code gates operate on product source, not the plan,
    // specifications, their configuration, or C ABI test fixtures.
    exempt-paths (.config/** docs/** plan/** conformance/**)

    // The gate bounds how much production code one file carries. It was
    // counting test functions too, which measures something else: a ported
    // file's test module has one function per rule it verifies, and vi.c has
    // forty-nine rules. Capping that at fifty makes the gate ask for the
    // tests to be split by nothing in particular, or for a bypass on every
    // file this pass touches. `trivial-function` already exempts test scope
    // for the same reason — a test helper is allowed to be a one-liner.
    //
    // This does not weaken the production reading. Every count that has
    // fired so far was a production count and still is; terminal.rs is still
    // held at its pre-image 76.
    function-density {exempt-test-scope true}

    // Directory scope splits a module from its own tests. `file-size` and
    // `function-density` both cap a file against its grandfathered pre-image,
    // and a ported file that is already over the default has no room for the
    // tests its own rules require — so those tests go in the conventional Rust
    // sibling, `chared.rs` plus `chared/test.rs`. That is one directory down,
    // and under directory scope the parent then reads as production with the
    // tests deleted.
    //
    // Measured at the moment it fired: `crates/nshedit/src` reported 0.138
    // against a 0.200 floor while holding 4,760 lines of test code in
    // subdirectories against 15,992 of production — 0.298 counted together.
    // The gate was not wrong about any file; it was measuring across a
    // boundary the code does not have.
    //
    // Crate scope is the smallest unit where "this crate's tests" and "this
    // crate's production code" are both whole. It does not lower the floor.
    test-footprint {scope crate}
}

commit {
    type-prefix "required"
}

adoption {
    scope "maintenance"
}
