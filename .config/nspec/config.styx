// The detailed libedit corpus constrains the Rust implementation and its
// direct C ABI acceptance fixtures. The nshedit corpus constrains the native
// Rust architecture.
specs (
    {
        name libedit,
        include (docs/spec/port/**/*.md),
        impls (
            // C and shell files are interface tests only. Product
            // implementation lives under crates/.
            {name target-impl, languages (@rust @c @bash), include (crates/**/*.rs), test_include (crates/**/tests/**/*.rs conformance/**/*.c conformance/**/*.sh), exclude (target/**), mode @both}
        )
    }
    {
        name nshedit,
        include (docs/spec/native/**/*.md),
        impls (
            // The Darwin cross-check is itself the required recorded command,
            // not merely evidence about a separate implementation.
            {name native-impl, languages (@rust @c @bash), include (Cargo.toml crates/**/*.rs ci/**/*.sh), test_include (crates/**/tests/**/*.rs conformance/**/*.c conformance/**/*.sh), exclude (target/**), mode @both}
        )
    }
)
